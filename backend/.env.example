PORT=4000
ADMIN_KEY=change-this-admin-passcode
VOTE_PRICE_GHS=1
TICKET_SINGLE_PRICE_GHS=150
TICKET_DOUBLE_PRICE_GHS=280
TICKET_EXECUTIVE_PRICE_GHS=180

# --- Paystack (card + Ghana Mobile Money, personal account) ---
# 1. Sign up at https://dashboard.paystack.com/#/signup as an individual
#    (Ghana's personal-account KYC needs a government ID + TIN, no business
#    registration). Test keys work immediately, before that KYC is done.
# 2. Dashboard > Settings > API Keys & Webhooks - copy both keys below.
#    The secret key must never be exposed to the frontend; the public key is
#    safe to expose (it's already sent to the browser via /api/config).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Ticket email delivery (via your own Gmail account, no third party) ---
# 1. Turn on 2-Step Verification on the Gmail account you want tickets to
#    come from: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
#    (NOT your normal Gmail login password - Google blocks that for SMTP)
# 3. Put the Gmail address and the 16-character App Password below.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Deployment (Render backend / Vercel frontend) ---
# Set once deployed - see README's Deployment section.
DATA_DIR=
FRONTEND_ORIGIN=
