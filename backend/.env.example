PORT=4000
ADMIN_KEY=change-this-admin-passcode
MOMO_NUMBER=0558756757
VOTE_PRICE_GHS=1
TICKET_SINGLE_PRICE_GHS=150
TICKET_DOUBLE_PRICE_GHS=280
TICKET_EXECUTIVE_PRICE_GHS=180

# --- MTN MoMo Open API (Collections) ---
# Direct integration with MTN - no aggregator, settles straight into your own
# MTN MoMo account. Only works for payers on the MTN network.
#
# SANDBOX (free, self-service, for testing):
#   1. Sign up at https://momodeveloper.mtn.com and subscribe to the
#      "Collections" product to get a subscription key.
#   2. Put that key in MTN_SUBSCRIPTION_KEY below.
#   3. Run: npm run mtn-setup
#      This prints MTN_API_USER / MTN_API_KEY to paste in below.
#   4. Use these sandbox values as-is:
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_TARGET_ENVIRONMENT=sandbox
MTN_CURRENCY=EUR
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=

# PRODUCTION (real money): requires MTN business/KYC approval via your
# account manager and the MoMo Partner Portal - this is not self-service and
# can take time. Once approved, switch these to:
#   MTN_BASE_URL=https://proxy.momoapi.mtn.com
#   MTN_TARGET_ENVIRONMENT=mtnghana
#   MTN_CURRENCY=GHS
#   MTN_SUBSCRIPTION_KEY=<production key from momoapi.mtn.com>
#   MTN_API_USER=<from your account manager / Partner Portal>
#   MTN_API_KEY=<from your account manager / Partner Portal>

# --- Ticket email delivery (via your own Gmail account, no third party) ---
# 1. Turn on 2-Step Verification on the Gmail account you want tickets to
#    come from: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
#    (NOT your normal Gmail login password - Google blocks that for SMTP)
# 3. Put the Gmail address and the 16-character App Password below.
GMAIL_USER=
GMAIL_APP_PASSWORD=
